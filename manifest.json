{
  "manifest_version": 3,
  "name": "Fiverr Time Tracker",
  "version": "1.0",
  "description": "Track how much time you spend on Fiverr.",
  "permissions": [
    "tabs",
    "storage",
    "idle"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
